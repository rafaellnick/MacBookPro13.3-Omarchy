#!/bin/bash
# Backstop trigger for touchbar-resume.service.
#
# That service is WantedBy=suspend.target, which normally runs it on resume.
# But its start job can be MERGED AWAY when a second suspend begins while the
# previous resume's run is still in flight. Observed 2026-09-07: resumes at
# 18:09:56 and 18:11:12 produced only ONE hook run (18:09:57) - the second
# suspend started at 18:09:57.35, a 30ms overlap with that run finishing at
# 18:09:57.38 - and the Touch Bar stayed dark until it was started by hand.
#
# systemd-sleep executes this directly for every cycle, so there is no systemd
# job here to merge. It is a BACKSTOP, not a replacement: the unit keeps its own
# WantedBy trigger, so neither path is a single point of failure, and
# touchbar-resume.sh debounces on /run/touchbar/last-resume-reload so whichever
# fires first wins and the other no-ops instead of reloading the module twice.
#
# --no-block matters: this runs inside the sleep transaction, and resume must
# not wait on an rmmod/insmod.

[ "$1" = post ] || exit 0

case "$2" in
suspend | hibernate | hybrid-sleep | suspend-then-hibernate) ;;
*) exit 0 ;;
esac

exec systemctl restart --no-block touchbar-resume.service
