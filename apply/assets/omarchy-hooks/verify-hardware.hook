#!/bin/bash
# Post-boot health check. Silent when healthy; one persistent notification on
# regressions that materially affect this machine.

set -uo pipefail

problems=()
KREL=$(uname -r)

if command -v dkms >/dev/null 2>&1; then
	dkms_status=$(dkms status 2>/dev/null || true)
	grep -q "^snd_hda_macbookpro/.*, $KREL, .*: installed" <<< "$dkms_status" \
		|| problems+=("Audio DKMS is missing for $KREL")
fi
aplay -l 2>/dev/null | grep -qi CS8409 \
	|| problems+=("CS8409/CS42L83 audio codec is not bound")
systemctl is-active --quiet t1-touchbar-hw.service \
	|| problems+=("T1Bridge hardware service is not active")
systemctl --user is-active --quiet t1-touchbar.service \
	|| problems+=("T1Bridge renderer is not active")
grep -q '^brcmfmac ' /proc/modules \
	|| problems+=("Broadcom Wi-Fi driver is not loaded")

if [[ -r /sys/kernel/debug/vgaswitcheroo/switch ]]; then
	grep -q 'DIS:.*:Off:' /sys/kernel/debug/vgaswitcheroo/switch \
		|| problems+=("Radeon dGPU is still powered")
fi
[[ ! -e /sys/bus/pci/devices/0000:01:00.1 ]] \
	|| problems+=("unused Radeon HDMI-audio function is still present")

((${#problems[@]})) || exit 0
body=$(printf '%s\n' "${problems[@]}")
logger -t verify-hardware "FAIL: ${problems[*]}"
omarchy-notification-send -g 󰀪 -u critical 'MacBook hardware check failed' \
	"$body" -t 0 >/dev/null 2>&1 || true
