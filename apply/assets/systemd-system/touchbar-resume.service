[Unit]
Description=Re-enable the Apple T1 Touch Bar after resume
# The iBridge HID interfaces survive s2idle, but apple-ibridge stops driving
# the Touch Bar across the suspend: the strip comes back dark and stays dark.
# Re-running touchbar.service rebinds the interfaces and repaints it.
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/touchbar-resume.sh

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
